  "narrative": {
    "northStar": "The Guided Scan Workspace",
    "overview": "Porcelain paper, graphite type, mineral teal actions, fine rules, and instrument-like controls retain the established Stoma3D identity. The public root now opens the existing scan workspace directly; the retired marketing hero is not the reference for new screens. Task surfaces are calm and specific, with generous photo areas and short, readable instructions.\n\nThe separate, visibly labeled Sample demo uses the same visual language. Synthetic artwork and prepared observations explain the journey without posing as real patient records or live analysis. Authenticated patient and clinician workspaces remain denser operating surfaces: mineral paper sidebars, plain ledgers, and precise status language rather than smaller landing pages.",
    "keyCharacteristics": [
      "Porcelain and white surfaces, graphite text, restrained mineral teal.",
      "Compact system-sans headings and instrument-like controls.",
      "Fine rules and whitespace before decorative containers.",
      "Photo-first review, reachable navigation, explicit sample provenance."
    ],
    "rules": [
      {
        "name": "The Purposeful Accent Rule",
        "body": "Teal carries ordinary actions and selection; amber is reserved for attention, focus, pending review, or a required decision. Dedicated destructive controls use the existing muted red, not an additional brand accent.",
        "section": "colors"
      },
      {
        "name": "The Paper Before Lift Rule",
        "body": "Use tone, spacing, and rules to establish hierarchy before adding elevation; preserve the limited depth of actual overlays and artifacts.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the porcelain, graphite, mineral teal, and system-sans identity.",
      "Do open directly into the scan workspace and keep the sample tour visibly separate.",
      "Do keep photos, focus indicators, text labels, and fixed controls readable at compact widths.",
      "Do identify synthetic artwork, authored outlines, and prepared values wherever they appear.",
      "Do preserve the dense, quiet authenticated ledgers and honest empty/error states."
    ],
    "donts": [
      "Don't restore the retired marketing hero or use it as the default page template.",
      "Don't introduce decorative medical color coding, gradients, or general glass surfaces.",
      "Don't mix sample observations into saved real scans or replace a failed result with examples.",
      "Don't label the generic map a digital twin or imply clinical validity through visual polish.",
      "Don't repeat the non-diagnostic warning on every capture or navigation screen."
    ]
  }
}
