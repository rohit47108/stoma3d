# Auth0 Regular Web Application
# Set STOMA3D_WEB_MODE=public for a public competition site without hosted
# accounts. In that mode, only NEXT_PUBLIC_SITE_URL is required.
# STOMA3D_WEB_MODE=public
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me
# Generate with: openssl rand -hex 32
AUTH0_SECRET=replace-with-64-hex-characters
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth0 API identifier configured for the platform service
AUTH0_AUDIENCE=stoma3d-platform-api

# Stateful Stoma3D platform API. Never expose this as NEXT_PUBLIC_*.
STOMA3D_PLATFORM_API_URL=http://127.0.0.1:8001

# Guest scans use this fixed inference destination and a pinned PUBLIC key.
# Include /api when using the Vercel inference deployment.
STOMA3D_INFERENCE_URL=http://127.0.0.1:8000
STOMA3D_RESPONSE_SIGNING_PUBLIC_KEY_B64=replace-with-raw-ed25519-public-key-base64

# CI-only escape hatch for builds that use explicit dummy values. Never set this
# in Vercel or another deployment environment.
# STOMA3D_ALLOW_CI_DUMMY_WEB_ENV=true
